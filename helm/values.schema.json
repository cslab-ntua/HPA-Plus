{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "mode",
    "image",
    "replicaCount",
    "leaderElection",
    "resources",
    "tmpSizeLimit",
    "terminationGracePeriodSeconds",
    "workers",
    "modelRetry",
    "networkPolicy",
    "hooks"
  ],
  "properties": {
    "cpuHistorySource": {
      "type": "string",
      "enum": [
        "metrics-server",
        "kubelet",
        "cgroup"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "cluster"
      ]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "leaderElection": {
      "type": "boolean"
    },
    "deploymentStrategy": {
      "type": "string",
      "enum": [
        "Recreate",
        "RollingUpdate"
      ]
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "tmpSizeLimit": {
      "type": "string",
      "minLength": 1
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "resources": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "workers": {
      "type": "object",
      "required": [
        "memoryMiB",
        "concurrency",
        "sessions"
      ],
      "additionalProperties": false,
      "properties": {
        "memoryMiB": {
          "type": "integer",
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 64,
              "maximum": 65536
            }
          ]
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "sessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "modelRetry": {
      "type": "object",
      "required": [
        "initial",
        "maximum"
      ],
      "additionalProperties": false,
      "properties": {
        "initial": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$"
        },
        "maximum": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$"
        }
      }
    },
    "workerIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "probeTransport",
        "resources",
        "tmpSizeLimit"
      ],
      "properties": {
        "probeTransport": {
          "type": "string",
          "enum": [
            "http",
            "exec"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "tmpSizeLimit": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "object",
          "required": [
            "limits"
          ],
          "properties": {
            "limits": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^([1-9][0-9]*([.][0-9]+)?|0[.][0-9]*[1-9][0-9]*)(m)?$"
                    },
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  ]
                },
                "memory": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[1-9][0-9]*([EPTGMK]i?|k)?$"
                }
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "ingress",
        "egress"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "ports"
            ],
            "properties": {
              "from": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/definitions/networkPeer"
                }
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/definitions/networkPort"
                }
              }
            }
          }
        },
        "egress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "to",
              "ports"
            ],
            "properties": {
              "to": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/definitions/networkPeer"
                }
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/definitions/networkPort"
                }
              }
            }
          }
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedOrigins",
        "credentials"
      ],
      "properties": {
        "allowedOrigins": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^https?://([a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?|\\[[0-9a-fA-F:.]+\\])(:[0-9]{1,5})?/?$"
          }
        },
        "credentials": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "origin",
              "namespace",
              "resourceNames",
              "secretName",
              "secretKey"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "origin": {
                "type": "string",
                "maxLength": 300,
                "pattern": "^https://([a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?|\\[[0-9a-fA-F:.]+\\])(:[0-9]{1,5})?/?$"
              },
              "namespace": {
                "type": "string",
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "resourceNames": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
                }
              },
              "secretName": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
              },
              "secretKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-zA-Z0-9._-]+$"
              }
            }
          }
        }
      }
    },
    "featureDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "maxFiles",
        "maxBytes",
        "maxAgeSeconds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 67108864
        },
        "maxAgeSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "info",
            "debug"
          ]
        }
      }
    },
    "cgroupCollector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "port",
        "interval",
        "retention",
        "nodeSelector",
        "resources",
        "watchNamespace"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "interval": {
          "type": "string",
          "enum": [
            "2s"
          ]
        },
        "retention": {
          "type": "string",
          "enum": [
            "3m"
          ]
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "resources": {
          "type": "object"
        },
        "watchNamespace": {
          "type": "string",
          "maxLength": 63
        }
      }
    },
    "trafficPrometheusURL": {
      "type": "string",
      "maxLength": 2048,
      "anyOf": [
        {
          "enum": [
            ""
          ]
        },
        {
          "pattern": "^https?://[^\\s]+$"
        }
      ]
    }
  },
  "definitions": {
    "networkSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matchLabels"
      ],
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "networkPeer": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "namespaceSelector": {
          "$ref": "#/definitions/networkSelector"
        },
        "podSelector": {
          "$ref": "#/definitions/networkSelector"
        },
        "ipBlock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cidr"
          ],
          "properties": {
            "cidr": {
              "type": "string",
              "minLength": 1
            },
            "except": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "ipBlock"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "podSelector"
                ]
              },
              {
                "required": [
                  "namespaceSelector"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "required": [
              "ipBlock"
            ]
          },
          "anyOf": [
            {
              "required": [
                "podSelector"
              ]
            },
            {
              "required": [
                "namespaceSelector"
              ]
            }
          ]
        }
      ]
    },
    "networkPort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "port"
      ],
      "properties": {
        "protocol": {
          "type": "string",
          "enum": [
            "TCP",
            "UDP"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "cpuHistorySource": {
            "const": "cgroup"
          }
        },
        "required": [
          "cpuHistorySource"
        ]
      },
      "then": {
        "properties": {
          "cgroupCollector": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        },
        "required": [
          "cgroupCollector"
        ]
      }
    }
  ]
}
